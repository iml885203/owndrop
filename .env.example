# OwnDrop — Self-Host / Node.js Configuration
PORT=4180
OWNDROP_ORIGIN=http://localhost:4180

# Required: Browser password login & session signing secret (>= 32 chars)
OWNDROP_PASSWORD=change-me-use-a-strong-password
OWNDROP_SESSION_SECRET=change-me-generate-at-least-32-random-characters

# Optional: Static fallback API token (>= 32 URL-safe chars)
# OWNDROP_API_TOKEN=

# Optional: Standard OIDC (e.g., Pocket ID, Authentik, Authelia)
# OWNDROP_OIDC_ISSUER=https://id.example.com
# OWNDROP_OIDC_CLIENT_ID=owndrop
# OWNDROP_OIDC_CLIENT_SECRET=your-oidc-client-secret
# OWNDROP_OIDC_REQUIRED_GROUP=homelab-admin

# Storage & retention limits
OWNDROP_DATA_DIR=.data
OWNDROP_SESSION_DAYS=180
OWNDROP_RETENTION_DAYS=90
OWNDROP_MAX_FILE_MB=90
OWNDROP_MAX_STORAGE_MB=4096
